@startuml
skinparam shadowing false
skinparam defaultFontSize 14
hide footbox

participant ":BakerCli" as Cli
participant "<<class>>\nParser" as Parser
participant ":AddOrderCommand" as Add
participant "orders:OrderList" as Orders
participant "<<class>>\nCapacityCommand" as Cap

[-> Cli : "add n/Alice ... d/21-12-2030 ..."
activate Cli
Cli -> Parser : parseAdd(input)
Parser --> Cli : details
create Add
Cli -> Add : new AddOrderCommand(details)
Cli -> Add : execute(orders)
activate Add
ref over Add, Orders : Create and add the order,\nassigning its Customer ID
Add -> Cap : warningFor(orders, dueDate)
activate Cap
Cap -> Orders : countOrdersDueOn(dueDate)
activate Orders
Orders --> Cap : count
deactivate Orders
Cap -> Orders : getDailyCapacity()
activate Orders
Orders --> Cap : capacity
deactivate Orders
Cap --> Add : warning, or "" if count <= capacity
deactivate Cap
Add --> Cli : order confirmation, optional warning, customer line
deactivate Add

Cli -> Cli : print the complete command result
[<-- Cli
deactivate Cli

note right of Cli
  After UpdateOrderCommand changes an order,
  BakerCli calls warningFor(...) directly
  with the updated due date.
end note
@enduml
