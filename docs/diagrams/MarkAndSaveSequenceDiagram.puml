@startuml MarkAndSaveSequenceDiagram
' Original diagram and mark implementation: HammerHead-os.
' Diagram integration, activation and layout revisions: Eethanzyj.
title Mark an order: successful QUEUED to PREPARING transition
skinparam shadowing false
skinparam defaultFontSize 14
hide footbox

actor Baker
participant ":BakerCli" as Cli
participant "<<class>>\nParser" as Parser
participant ":MarkCommand" as Mark
participant "orders:OrderList" as Orders
participant "order:Order" as Order

Baker -> Cli : mark O001 preparing
activate Cli
Cli -> Parser : parseMark(input)
activate Parser
Parser --> Cli : details: MarkDetails
deactivate Parser
create Mark
Cli -> Mark : new MarkCommand("O001", PREPARING)
activate Mark
deactivate Mark
Cli -> Mark : execute(orders)
activate Mark
Mark -> Orders : getById("O001")
activate Orders
Orders --> Mark : order
deactivate Orders
Mark -> Order : getStatus()
activate Order
Order --> Mark : QUEUED
deactivate Order
Mark -> Mark : isNextStep(QUEUED, PREPARING)
activate Mark
Mark --> Mark : true
deactivate Mark
note over Mark, Order
  Invalid transitions throw CakeQueueException instead.
  The CLI then prints an error without saving.
end note
Mark -> Order : setStatus(PREPARING)
activate Order
deactivate Order
Mark --> Cli : confirmation: String
deactivate Mark
Cli --> Baker : print confirmation
ref over Cli, Order : Run saveChanges callback;\nsee "Saving after every change".
deactivate Cli
@enduml
