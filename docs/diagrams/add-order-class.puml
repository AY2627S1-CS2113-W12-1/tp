@startuml
' Author: Eethanzyj
!pragma layout smetana
title Add Order and per-order customer details
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
hide empty members

class BakerCli {
  + run(scanner: Scanner, orders: OrderList, afterChange: Runnable): void
}
class Parser {
  {static} + parseAdd(input: String): AddOrderDetails
}
class OrderList {
  + generateOrderId(): String
  + add(order: Order): void
}
class AddOrderCommand {
  - details: Parser.AddOrderDetails
  + AddOrderCommand(details: Parser.AddOrderDetails)
  + execute(orders: OrderList): String
}
class Order {
  - orderId: String
  - customerId: String
  - dueDate: LocalDate
  - status: OrderStatus
}
class Customer {
  - name: String
  - phone: String
}
class Cake {
  - size: int
  - flavour: String
  - filling: String
}

BakerCli ..> Parser : parses
BakerCli ..> AddOrderCommand : creates and runs
AddOrderCommand ..> OrderList : adds order
AddOrderCommand ..> Order : creates
OrderList "1" --> "0..*" Order : stores
Order "0..*" --> "1" Customer
Order "0..*" --> "0..1" Cake

note bottom of Order
  Add Order always supplies one Customer
  and one Cake. Older constructors also
  support orders without cake details.
  OrderList.add assigns the Customer ID.
end note

note right of AddOrderCommand
  Receives validated details; no parsing.
  Returns the confirmation and warnings.
  BakerCli prints and requests saving.
end note
@enduml
