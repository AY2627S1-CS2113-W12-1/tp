@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontSize 14
hide empty members

class OrderList {
  - dailyCapacity: int
  + add(order: Order): void
  + getById(id: String): Order
  + update(order: Order): void
  + getAll(): ArrayList<Order>
  + countOrdersDueOn(date: LocalDate): int
  + countOrdersByDueDate(): TreeMap<LocalDate, Integer>
  + getDailyCapacity(): int
  + setDailyCapacity(n: int): void
}

class Order {
  - orderId: String
  - customerId: String
  - dueDate: LocalDate
  - notes: String
}

class Customer {
  - name: String
  - phone: String
}

class Cake {
  - size: int
  - flavour: String
  - filling: String
}

enum OrderStatus {
  ENQUIRY
  QUEUED
  PREPARING
  READY
  COLLECTED
  CANCELLED
  REJECTED
}

class CustomerList {
  {static} + fromOrders(orders: OrderList): CustomerList
  + getById(id: String): CustomerProfile
}

class CustomerProfile {
  - customerId: String
}

OrderList "1" --> "*" Order : stores
Order "*" --> "1" Customer
Order "*" --> "0..1" Cake
Order --> "1" OrderStatus : status
CustomerList *-- "*" CustomerProfile
CustomerProfile --> "1..*" Order : references
CustomerList ..> OrderList : built from

note right of OrderStatus
  ENQUIRY and REJECTED are retained
  for legacy saved records only.
end note

note bottom of Order
  Notes are retained for compatibility.
  No CLI command changes them.
end note
@enduml
