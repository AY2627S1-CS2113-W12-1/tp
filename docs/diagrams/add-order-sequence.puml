@startuml
' Author: Eethanzyj
title Add Order: create an order after validation
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam sequenceMessageAlign center
hide footbox

participant ":BakerCli" as Cli
participant ":AddOrderCommand" as Add
participant "orders:OrderList" as Orders
participant "order:Order" as Order

note over Cli, Orders
  Precondition: Parser.parseAdd has returned validated details.
  Customer lookup and capacity checks are omitted here.
end note
activate Cli
create Add
Cli -> Add : new AddOrderCommand(details)
Cli -> Add : execute(orders)
activate Add
Add -> Orders : generateOrderId()
activate Orders
Orders --> Add : orderId
deactivate Orders
note over Add, Orders
  Create one Customer and one Cake from the details.
  Their construction is omitted for clarity.
end note
create Order
Add -> Order : new Order(orderId, customer,\ncake, dueDate)
activate Order
note over Orders, Order : Initial status: QUEUED
deactivate Order
Add -> Orders : add(order)
activate Orders
Orders -> Order : setCustomerId(customerId)
activate Order
deactivate Order
note over Orders, Order
  Reuse a matching phone's Customer ID,
  or allocate the next one, then store the order.
end note
Orders --> Add
deactivate Orders
note over Add, Orders
  Build the confirmation, including any capacity
  warning and the new/returning customer label.
end note
Add --> Cli : result: String
deactivate Add
note over Cli, Add
  Next: display the result and request saving
  (separate diagram).
end note
deactivate Cli
@enduml
