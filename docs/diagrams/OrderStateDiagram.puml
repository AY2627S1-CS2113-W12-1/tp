@startuml OrderStateDiagram
skinparam shadowing false
skinparam defaultFontSize 14

[*] --> ENQUIRY : enquire
[*] --> QUEUED : add

ENQUIRY --> QUEUED : accept\n(new O-prefixed ID)
ENQUIRY --> REJECTED : reject
ENQUIRY --> CANCELLED : cancel

QUEUED --> PREPARING : mark preparing
PREPARING --> READY : mark ready
READY --> COLLECTED : mark collected
QUEUED --> CANCELLED : cancel
PREPARING --> CANCELLED : cancel
READY --> CANCELLED : cancel

COLLECTED --> [*] : delete
CANCELLED --> [*] : delete
REJECTED --> [*] : delete

note right of QUEUED
  mark moves one step at a time.
  Skipping (QUEUED to READY) or
  going backwards is rejected.
end note
@enduml
