@startuml EnquireAcceptSequenceDiagram
skinparam shadowing false
skinparam defaultFontSize 14
hide footbox

actor Baker
participant ":BakerCli" as Cli
participant "<<class>>\nParser" as Parser
participant ":AcceptEnquiryCommand" as Accept
participant "orders:OrderList" as List

Baker -> Cli : accept E001
activate Cli
Cli -> Parser : parseAccept(input)
activate Parser
Parser --> Cli : "E001"
deactivate Parser
create Accept
Cli -> Accept : new AcceptEnquiryCommand("E001")
Cli -> Accept : execute(orders)
activate Accept
Accept -> List : getById("E001")
activate List
List --> Accept : enquiry
deactivate List
Accept -> List : removeById("E001")
Accept -> List : generateOrderId()
List --> Accept : "O001"
Accept -> List : add(order O001, same details, QUEUED)
Accept --> Cli : "Accepted enquiry E001 as order O001 ..."
deactivate Accept
Cli -> Cli : append capacity warning, if any
Cli -> Cli : afterChange.run() (save)
Cli --> Baker : print result
deactivate Cli
@enduml
